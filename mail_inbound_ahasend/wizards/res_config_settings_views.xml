<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ahasend.inbound</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail_ahasend.res_config_settings_view_form" />
        <!-- Views apply by priority, each one right after the AhaSend box:
             the highest priority comes first. Tracking, inbound, test copies. -->
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='mail_ahasend']" position="after">
                <setting
                    id="mail_inbound_ahasend"
                    class="col-lg-12"
                    string="Inbound email"
                    help="Receive email for Odoo's aliases from AhaSend, without a mail server to poll."
                    invisible="not mail_ahasend_enabled"
                >
                    <field name="mail_inbound_ahasend_route_id" invisible="1" />
                    <div class="content-group">
                        <div class="row mt8">
                            <label
                                for="mail_inbound_ahasend_domain"
                                string="Inbound domain"
                                class="col-lg-3 o_light_label"
                            />
                            <field
                                class="col-lg-5"
                                name="mail_inbound_ahasend_domain"
                                placeholder="odoo.example.com"
                                readonly="mail_inbound_ahasend_route_id"
                            />
                        </div>
                        <div
                            class="mt8 text-success"
                            invisible="not mail_inbound_ahasend_route_id"
                        >
                            <i class="fa fa-check" title="Connected" /> Connected.
                            Odoo receives inbound email from AhaSend.
                        </div>
                        <div class="mt8">
                            <button
                                type="object"
                                name="action_ahasend_connect_inbound"
                                string="Connect inbound email"
                                icon="oi-arrow-right"
                                class="btn-link"
                                invisible="mail_inbound_ahasend_route_id"
                            />
                            <button
                                type="object"
                                name="action_ahasend_disconnect_inbound"
                                string="Disconnect inbound email"
                                icon="oi-arrow-right"
                                class="btn-link"
                                invisible="not mail_inbound_ahasend_route_id"
                                confirm="This deletes the AhaSend route that Odoo created. AhaSend stops posting inbound email to Odoo until you connect again."
                            />
                        </div>
                        <div class="mt16" groups="base.group_no_one">
                            <div class="o_form_label">Manual route setup</div>
                            <div class="text-muted">
                                Only needed when you create the route in the
                                AhaSend dashboard yourself.
                            </div>
                            <div>
                                <a
                                    href="https://dash.ahasend.com/account/-/integrations/routes"
                                    target="_blank"
                                ><i
                                    class="oi oi-arrow-right"
                                /> Open the routes page</a>
                            </div>
                            <div class="row mt8">
                                <label
                                    for="mail_inbound_ahasend_route_url"
                                    string="Endpoint URL"
                                    class="col-lg-3 o_light_label"
                                />
                                <field
                                    class="col-lg-5"
                                    name="mail_inbound_ahasend_route_url"
                                    widget="CopyClipboardChar"
                                />
                            </div>
                            <div class="row">
                                <label
                                    for="mail_inbound_ahasend_route_secret"
                                    string="Route secret"
                                    class="col-lg-3 o_light_label"
                                />
                                <field
                                    class="col-lg-5"
                                    name="mail_inbound_ahasend_route_secret"
                                    password="True"
                                />
                            </div>
                            <div
                                class="row"
                                invisible="not mail_inbound_ahasend_route_id"
                            >
                                <label
                                    for="mail_inbound_ahasend_route_id"
                                    string="Route ID"
                                    class="col-lg-3 o_light_label"
                                />
                                <field
                                    class="col-lg-5"
                                    name="mail_inbound_ahasend_route_id"
                                />
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
