<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ahasend.sandbox</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail_ahasend.res_config_settings_view_form" />
        <!-- Views apply by priority, each one right after the AhaSend box:
             the highest priority comes first. Tracking, inbound, test copies. -->
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='mail_ahasend']" position="after">
                <setting
                    id="mail_sandbox_ahasend"
                    class="col-lg-12"
                    string="Test copies"
                    help="Neutralized copies of this database send their email to the AhaSend sandbox, where you can view it. Nothing is delivered."
                    invisible="not mail_ahasend_enabled"
                >
                    <field name="mail_sandbox_ahasend_is_copy" invisible="1" />
                    <div class="content-group">
                        <div class="mt8" invisible="mail_sandbox_ahasend_smtp_user">
                            <button
                                type="object"
                                name="action_ahasend_create_sandbox_credential"
                                string="Create sandbox credential"
                                icon="oi-arrow-right"
                                class="btn-link"
                            />
                        </div>
                        <div class="row mt8">
                            <label
                                for="mail_sandbox_ahasend_smtp_user"
                                string="Sandbox username"
                                class="col-lg-3 o_light_label"
                            />
                            <field
                                class="col-lg-5"
                                name="mail_sandbox_ahasend_smtp_user"
                            />
                        </div>
                        <div class="row">
                            <label
                                for="mail_sandbox_ahasend_smtp_password"
                                string="Sandbox password"
                                class="col-lg-3 o_light_label"
                            />
                            <field
                                class="col-lg-5"
                                name="mail_sandbox_ahasend_smtp_password"
                                password="True"
                            />
                        </div>
                        <div
                            class="mt8"
                            invisible="not mail_sandbox_ahasend_smtp_user"
                        >
                            <button
                                type="object"
                                name="action_ahasend_clear_sandbox_credential"
                                string="Disconnect test copies"
                                icon="oi-arrow-right"
                                class="btn-link"
                                confirm="This removes the sandbox username and password from Odoo. Copies made from now on send no email at all. The credential stays in your AhaSend account; you can delete it on the credentials page of the dashboard."
                            />
                        </div>
                        <div
                            class="mt8 text-success"
                            invisible="not mail_sandbox_ahasend_is_copy"
                        >
                            <i class="fa fa-flask" title="Sandbox" /> This database is a
                            neutralized copy: its email goes to the AhaSend sandbox.
                        </div>
                        <div class="mt8" invisible="not mail_sandbox_ahasend_is_copy">
                            <button
                                type="object"
                                name="action_ahasend_sandbox_server_setup"
                                string="Use the AhaSend sandbox"
                                icon="oi-arrow-right"
                                class="btn-link"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
